.permission-card, .current-card, .upload-card { padding: 30rpx; }
.identity-label { font-size: 22rpx; color: #7b9183; margin-top: 36rpx; }
.openid { display: block; font-family: monospace; font-size: 24rpx; line-height: 1.8; overflow-wrap: anywhere; padding-top: 12rpx; }
.admin-badge { margin-top: 30rpx; display: flex; align-items: center; gap: 12rpx; font-size: 24rpx; color: #327653; }
.badge-dot { width: 12rpx; height: 12rpx; background: #3b9267; border-radius: 50%; }
.current-card { margin-top: 24rpx; }
.current-image { display: block; width: 100%; height: 320rpx; margin: 24rpx 0; background: #f4f7f4; border-radius: 14rpx; }
.current-empty { padding: 40rpx 0; }
.version { margin-top: 6rpx; }
.upload-card { margin-top: 26rpx; }
.selected-image { width: 100%; display: block; margin-top: 24rpx; border-radius: 14rpx; }
.upload-placeholder { margin-top: 24rpx; border: 2rpx dashed #c8d9ce; border-radius: 18rpx; padding: 40rpx 16rpx; text-align: center; color: #668370; font-size: 26rpx; }
.upload-plus { font-size: 56rpx; line-height: 1.3; margin-bottom: 12rpx; font-weight: 300; }
.file-hint { font-size: 21rpx; margin-top: 18rpx; }
.upload-note { margin-top: 22rpx; font-size: 22rpx; }
.notice { margin-top: 28rpx; padding: 26rpx; background: #e7f0e9; border-radius: 16rpx; color: #37684d; line-height: 1.8; font-size: 25rpx; }
.back-link { background: transparent; color: #597563; margin-top: 24rpx; font-size: 25rpx; }
.publish-progress { margin-top: 20rpx; }
